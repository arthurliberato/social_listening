DATABASE_URL=postgres://ripplewise:ripplewise@localhost:5432/ripplewise
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
APP_URL=http://localhost:3000
# Optional: deliver mail to Mailpit as well as the in-app /inbox
SMTP_URL=smtp://localhost:1025
# Optional analytics destinations (events are always mirrored to Postgres)
# RudderStack: one source collects every event and delivers it to BigQuery (and anything added later).
# The app sends everything from the server (browser events pass through /api/track first), so there are no browser
# settings. Both values are on the source's page in RudderStack. Leave empty to send nothing (events still go to Postgres).
RUDDERSTACK_WRITE_KEY=
RUDDERSTACK_DATA_PLANE_URL=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
